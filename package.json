{
  "name": "clefwing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Gamified sight-reading trainer for acoustic piano, using the iPad microphone.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios": "node scripts/voices.mjs --check && npm run build && npx cap sync ios && npx cap open ios",
    "voices": "node scripts/voices.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vexflow": "^4.2.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
